#!/usr/bin/env bash
# aequalyn-install -- launch the QML installer.
#
# Interactive runs use the Quickshell-based UI in this directory. The legacy
# command-line flags are delegated to aequalyn-install-cli for unattended,
# repair and detection workflows.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AEQUALYN_INSTALLER_DIR="$SELF_DIR"
export AEQUALYN_INSTALLER_DIR

# Delegate non-interactive / special modes to the CLI backend.
for arg in "$@"; do
    case "$arg" in
        --config|--repair|--detect|--dry-run|-h|--help)
            exec bash "$SELF_DIR/aequalyn-install-cli" "$@"
            ;;
    esac
done

# Graphical installer.
if command -v quickshell >/dev/null 2>&1; then
    exec quickshell -p "$SELF_DIR/shell.qml" "$@"
elif command -v qs >/dev/null 2>&1; then
    exec qs -p "$SELF_DIR/shell.qml" "$@"
else
    printf 'quickshell not found; falling back to CLI installer\n' >&2
    exec bash "$SELF_DIR/aequalyn-install-cli" "$@"
fi
