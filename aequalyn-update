#!/usr/bin/env bash
# aequalyn-update -- pull latest Aequalyn from GitHub and re-apply dotfiles.
#
#   aequalyn-update          git pull /usr/share/aequalyn, then re-apply
#                            dotfiles to the current user's home
#   aequalyn-update --no-pull  re-apply the local copy without touching git
#
# Intended to be run by the installed user (not root) whenever a new release
# is pushed to github.com/Aequalyn/aequalyn. It refreshes:
#   * the system source tree at /usr/share/aequalyn  (git pull)
#   * the user's dotfiles      (~/.config, ~/.local/bin, ~/Pictures, ...)
#   * the helper scripts in /usr/local/bin             (sudo cp)
#
set -euo pipefail

DO_PULL=1
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-pull) DO_PULL=0; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done

AQ_ROOT=/usr/share/aequalyn
[[ -d "$AQ_ROOT" ]] || { echo "aequalyn-update: $AQ_ROOT not found" >&2; exit 1; }

# /usr/share/aequalyn is root-owned; git needs safe.directory + sudo to
# operate on it as a normal user. Keep sudo empty when already root.
SUDO=""
[[ $EUID -ne 0 ]] && SUDO=sudo
$SUDO git config --global --add safe.directory "$AQ_ROOT" 2>/dev/null || true

if [[ $DO_PULL -eq 1 ]]; then
    if [[ ! -d "$AQ_ROOT/.git" ]]; then
        echo "aequalyn-update: $AQ_ROOT is not a git clone; cannot pull from GitHub" >&2
        echo "       Re-install Aequalyn, or initialize it manually:" >&2
        echo "       sudo git init $AQ_ROOT && sudo git -C $AQ_ROOT remote add origin https://github.com/Aequalyn/aequalyn.git" >&2
        exit 1
    fi
    echo "==> pulling latest Aequalyn from GitHub"
    $SUDO git -C "$AQ_ROOT" fetch --depth 1 origin main
    # Point local main at origin/main and reset the working tree to match.
    # /usr/share/aequalyn is managed by the installer (plain copies), so all
    # files are untracked: a plain checkout would refuse to overwrite them.
    $SUDO git -C "$AQ_ROOT" checkout -B main origin/main 2>/dev/null \
        || $SUDO git -C "$AQ_ROOT" reset --hard origin/main
fi

echo "==> fetching latest shell"
SHELL_DIR="$AQ_ROOT/shell"
if [[ -d "$SHELL_DIR/.git" ]]; then
    $SUDO git -C "$SHELL_DIR" pull --ff-only -q >/dev/null 2>&1 || true
else
    # Legacy bundled copy: replace with a live clone so future updates track git.
    $SUDO rm -rf "$SHELL_DIR"
    $SUDO git clone -q --depth 1 https://github.com/Aequalyn/aequalyn-shell.git "$SHELL_DIR" >/dev/null 2>&1 || true
fi
export AEQUALYN_SHELL_DIR="$SHELL_DIR"

echo "==> re-applying dotfiles to $HOME (skipping .config/hypr)"
bash "$AQ_ROOT/install.sh" --target "$HOME" --skip-hypr

echo "==> refreshing helper scripts in /usr/local/bin"
sudo cp -a "$AQ_ROOT/bin/." /usr/local/bin/
sudo chmod 755 /usr/local/bin/aequalyn-* 2>/dev/null || true

echo "==> restarting the shell"
if pgrep -x qs >/dev/null 2>&1; then
    pkill -x qs 2>/dev/null || true
    for _ in $(seq 1 25); do
        pgrep -x qs >/dev/null 2>&1 || break
        sleep 0.2
    done
fi
if command -v aequalyn-session-start >/dev/null 2>&1; then
    aequalyn-session-start >/dev/null 2>&1 || true
else
    QS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
    if command -v qs >/dev/null 2>&1; then
        nohup qs -n -d -p "$QS_CONFIG" >/dev/null 2>&1 &
        disown
    fi
fi

echo "==> done. Shell restarted."
