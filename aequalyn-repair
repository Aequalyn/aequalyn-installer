#!/bin/bash

# System Repair Script for Arch Linux Live ISO
# Allows disk selection, auto-detects encryption, mounts the system and chroots into it
#
#   aequalyn-repair                   pick the disk, mount it, then ask about a chroot
#   aequalyn-repair --mode keyring    ... then refresh the Arch Linux keyring
#   aequalyn-repair --mode kernel     ... then reinstall the kernel(s) and rebuild the boot files
#   aequalyn-repair --mode bootloader ... then reinstall Limine and its boot entries
#   aequalyn-repair --mode manual     ... then go straight into a chroot shell

set -euo pipefail
# whatever mask this was started under: what it writes is for every user to read
umask 022

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global variables
SELECTED_DISK=""
SELECTED_PARTITION=""
ENCRYPTED_DISK=false
ROOT_DEVICE=""
CRYPT_NAME="cryptroot"
MOUNT_POINT="/mnt"
FILESYSTEM=""
MODE=""

# Functions
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

check_dependencies() {
    print_status "Checking dependencies..."
    local deps=("cryptsetup" "lsblk" "blkid" "mount" "umount" "btrfs" "arch-chroot")
    local dep
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            print_error "Missing dependency: $dep"
            exit 1
        fi
    done
    print_success "All dependencies found"
}

select_disk() {
    print_status "Available disks:"
    mapfile -t disks < <(lsblk -dno NAME,SIZE,MODEL)

    if [[ ${#disks[@]} -eq 0 ]]; then
        print_error "No disks found."
        exit 1
    fi

    while true; do
        echo " 0) Quit"
        for i in "${!disks[@]}"; do
            echo "  $((i+1)). ${disks[$i]}"
        done
        read -rp "Select a disk: " choice

        if [[ "$choice" == "0" ]]; then
            print_status "Exiting."
            exit 0
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#disks[@]} )); then
            local name
            name=$(awk '{print $1}' <<< "${disks[$((choice-1))]}")
            SELECTED_DISK="/dev/$name"
            print_success "Selected disk: $SELECTED_DISK"
            return
        fi

        print_error "Invalid selection, try again."
    done
}

pick_partition() {
    local -n parts=$1
    if [[ ${#parts[@]} -eq 1 ]]; then
        SELECTED_PARTITION="${parts[0]}"
        print_success "Using partition: $SELECTED_PARTITION"
        return
    fi

    while true; do
        print_status "Multiple matching partitions found:"
        echo " 0) Quit"
        for i in "${!parts[@]}"; do
            local size ftype
            size=$(lsblk -no SIZE "${parts[$i]}" 2>/dev/null || echo "?")
            ftype=$(lsblk -no FSTYPE "${parts[$i]}" 2>/dev/null || echo "?")
            echo "  $((i+1)). ${parts[$i]} ($size, $ftype)"
        done
        read -rp "Select a partition: " choice

        if [[ "$choice" == "0" ]]; then
            print_status "Exiting."
            exit 0
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#parts[@]} )); then
            SELECTED_PARTITION="${parts[$((choice-1))]}"
            print_success "Selected partition: $SELECTED_PARTITION"
            return
        fi

        print_error "Invalid selection, try again."
    done
}

detect_encryption() {
    print_status "Scanning partitions of $SELECTED_DISK..."
    local partitions=()
    local part fstype
    while IFS= read -r part; do
        partitions+=("$part")
    done < <(lsblk -npr -o NAME,TYPE "$SELECTED_DISK" | awk '$2 == "part" { print $1 }')

    local luks_parts=() fs_parts=()
    for part in "${partitions[@]}"; do
        fstype=$(blkid -o value -s TYPE "$part" 2>/dev/null || echo "")
        case "$fstype" in
            crypto_LUKS) luks_parts+=("$part") ;;
            btrfs|ext4|xfs) fs_parts+=("$part") ;;
        esac
    done

    if (( ${#luks_parts[@]} > 0 )); then
        print_status "Encrypted (LUKS) partition detected."
        ENCRYPTED_DISK=true
        pick_partition luks_parts
        print_success "Using encrypted partition: $SELECTED_PARTITION"
    else
        print_status "No encryption detected on $SELECTED_DISK."
        if (( ${#fs_parts[@]} > 0 )); then
            pick_partition fs_parts
            print_success "Using filesystem partition: $SELECTED_PARTITION"
        else
            print_error "No mountable filesystem found on $SELECTED_DISK."
            exit 1
        fi
    fi
}

unlock_encrypted_drive() {
    print_status "Unlocking encrypted drive: $SELECTED_PARTITION"

    if [[ -e "/dev/mapper/$CRYPT_NAME" ]]; then
        print_warning "Device $CRYPT_NAME already exists, attempting to close first..."
        cryptsetup close "$CRYPT_NAME" || true
    fi

    if ! cryptsetup open "$SELECTED_PARTITION" "$CRYPT_NAME"; then
        print_error "Failed to unlock encrypted partition."
        print_status "Please check the passphrase and try again."
        exit 1
    fi

    print_success "Successfully unlocked encrypted partition"
}

detect_filesystem() {
    local device=$1
    print_status "Detecting filesystem on $device..."
    local fstype
    fstype=$(blkid -o value -s TYPE "$device" 2>/dev/null || echo "")

    case "$fstype" in
        btrfs) FILESYSTEM="btrfs" ;;
        ext4) FILESYSTEM="ext4" ;;
        xfs) FILESYSTEM="xfs" ;;
        *)
            print_status "Unable to auto-detect filesystem. Please specify:"
            echo "1) ext4"
            echo "2) btrfs"
            echo "3) xfs"
            read -rp "Choose filesystem [1-3]: " fs_choice
            case "$fs_choice" in
                1) FILESYSTEM="ext4" ;;
                2) FILESYSTEM="btrfs" ;;
                3) FILESYSTEM="xfs" ;;
                *) print_error "Invalid choice"; exit 1 ;;
            esac
            ;;
    esac

    print_success "Detected filesystem: $FILESYSTEM"
}

mount_filesystem() {
    local device=$1
    print_status "Mounting filesystem..."
    [[ ! -d "$MOUNT_POINT" ]] && mkdir -p "$MOUNT_POINT"

    case "$FILESYSTEM" in
        btrfs)
            mount_btrfs_subvolumes "$device"
            ;;
        ext4|xfs)
            mount "$device" "$MOUNT_POINT"
            print_success "Mounted $FILESYSTEM filesystem"
            ;;
        *)
            print_error "Unsupported filesystem: $FILESYSTEM"
            exit 1
            ;;
    esac
}

mount_btrfs_subvolumes() {
    local device=$1
    print_status "Scanning Btrfs subvolumes on $device..."

    mount "$device" "$MOUNT_POINT"

    btrfs subvolume list "$MOUNT_POINT" >/dev/null 2>&1 || print_warning "Could not list subvolumes"

    # Common subvolume patterns
    local common_subvols=("@" "@home" "@log" "@pkg" "@.snapshots" "@snapshots" "@var" "@root")
    local found_subvols=()
    local subvol
    for subvol in "${common_subvols[@]}"; do
        if btrfs subvolume show "$MOUNT_POINT/$subvol" &>/dev/null; then
            found_subvols+=("$subvol")
        fi
    done

    umount "$MOUNT_POINT"

    if [[ ${#found_subvols[@]} -eq 0 ]]; then
        mount "$device" "$MOUNT_POINT"
        print_warning "No subvolumes detected, mounting as single volume"
    elif [[ " ${found_subvols[*]} " =~ " @ " ]]; then
        mount -o subvol=@ "$device" "$MOUNT_POINT"
        print_success "Mounted @ subvolume"

        for subvol in "${found_subvols[@]}"; do
            if [[ "$subvol" != "@" ]]; then
                local mount_path=""
                case "$subvol" in
                    "@home") mount_path="$MOUNT_POINT/home" ;;
                    "@log") mount_path="$MOUNT_POINT/var/log" ;;
                    "@pkg") mount_path="$MOUNT_POINT/var/cache/pacman/pkg" ;;
                    "@.snapshots"|"@snapshots") mount_path="$MOUNT_POINT/.snapshots" ;;
                    "@var") mount_path="$MOUNT_POINT/var" ;;
                    "@root") mount_path="$MOUNT_POINT/root" ;;
                    *) continue ;;
                esac

                [[ ! -d "$mount_path" ]] && mkdir -p "$mount_path"
                mount -o subvol="$subvol" "$device" "$mount_path"
                print_success "Mounted $subvol to $mount_path"
            fi
        done
    else
        # No @ subvolume. Mounting an arbitrary subvolume as / would be a guess:
        # @home is commonly the first one found, and treating it as the root
        # filesystem means writing to the wrong place. Mount the top level and
        # let the operator mount the right subvolume by hand.
        mount "$device" "$MOUNT_POINT"
        print_warning "No @ subvolume found. Present subvolumes: ${found_subvols[*]}"
        print_warning "Mounted the top level of $device, which is not the root filesystem."
        print_warning "If this layout puts the root elsewhere, mount it by hand:"
        print_warning "  umount $MOUNT_POINT"
        print_warning "  mount -o subvol=<name> $device $MOUNT_POINT"
    fi
}

mount_boot_partitions() {
    print_status "Looking for boot partitions on $SELECTED_DISK..."
    local efi_part="" boot_part=""
    local part partname label fstype
    while IFS= read -r part; do
        [[ "$part" == "$SELECTED_PARTITION" ]] && continue
        partname=$(basename "$part")
        # Trailing partition number: "1" for both sda1 and nvme0n1p1, "11" for
        # sda11, empty for a whole disk. Comparing the number beats matching the
        # name, which previously only ever matched sda1 and left unlabelled NVMe
        # layouts with an ESP and no boot partition.
        partnum="${partname##*[!0-9]}"
        label=$(lsblk -no LABEL "$part" 2>/dev/null || echo "")
        fstype=$(lsblk -no FSTYPE "$part" 2>/dev/null || echo "")

        case "$fstype" in
            vfat)
                if [[ "$label" == "EFI" ]] || [[ "$partnum" == "1" || "$partnum" == "2" ]]; then
                    efi_part="$part"
                fi
                ;;
            ext2|ext3|ext4)
                if [[ "$label" == "BOOT" ]] || [[ "$partnum" == "1" ]]; then
                    boot_part="$part"
                fi
                ;;
        esac
    done < <(lsblk -npr -o NAME,TYPE "$SELECTED_DISK" | awk '$2 == "part" { print $1 }')

    if [[ -n "$boot_part" ]]; then
        [[ ! -d "$MOUNT_POINT/boot" ]] && mkdir -p "$MOUNT_POINT/boot"
        mount "$boot_part" "$MOUNT_POINT/boot"
        print_success "Mounted boot partition: $boot_part"

        if [[ -n "$efi_part" ]]; then
            [[ ! -d "$MOUNT_POINT/boot/efi" ]] && mkdir -p "$MOUNT_POINT/boot/efi"
            mount "$efi_part" "$MOUNT_POINT/boot/efi"
            print_success "Mounted EFI partition: $efi_part"
        fi
    elif [[ -n "$efi_part" ]]; then
        # No separate /boot, so the ESP goes to its proper mount point. It used
        # to be mounted at /mnt/boot, which put a vfat filesystem where the
        # bootloader looks for the kernel and initramfs.
        [[ ! -d "$MOUNT_POINT/boot/efi" ]] && mkdir -p "$MOUNT_POINT/boot/efi"
        mount "$efi_part" "$MOUNT_POINT/boot/efi"
        print_success "Mounted EFI partition: $efi_part"
        print_warning "No /boot partition found; the ESP is mounted at $MOUNT_POINT/boot/efi."
    else
        print_warning "No boot or EFI partition found, skipping."
    fi
}

mount_virtual_filesystems() {
    print_status "Mounting virtual filesystems..."
    local dir
    for dir in dev proc sys run; do
        [[ ! -d "$MOUNT_POINT/$dir" ]] && mkdir -p "$MOUNT_POINT/$dir"
        mount --bind "/$dir" "$MOUNT_POINT/$dir"
    done
    print_success "Mounted virtual filesystems"
}

enter_chroot() {
    print_status "Entering arch-chroot environment..."
    print_status "You can now perform system maintenance tasks."
    print_status "Common commands:"
    echo "  pacman -Syu                    # Update system"
    echo "  mkinitcpio -P                  # Regenerate initramfs"
    echo "  passwd username                # Reset password"
    echo "  systemctl enable service       # Enable service"
    echo "  exit                           # Leave chroot"

    arch-chroot "$MOUNT_POINT"
}

ask_chroot() {
    echo
    read -rp "Do you want to chroot into the system? (y/N): " answer
    case "${answer,,}" in
        y|yes)
            enter_chroot
            ;;
        *)
            print_status "Exiting without chrooting."
            ;;
    esac
}

# ---- repair modes ----------------------------------------------------------
# Each runs after the system is mounted. The installed system's own fstab is
# mounted first, so /boot is where Aequalyn keeps it (its EFI partition, with
# Limine) whatever was guessed above.
mount_from_fstab() {
    if [[ -f "$MOUNT_POINT/etc/fstab" ]]; then
        if arch-chroot "$MOUNT_POINT" mount -a 2>/dev/null; then
            print_success "Mounted the system's own fstab entries"
        else
            print_warning "Some fstab entries could not be mounted; carrying on with the rest"
        fi
    fi
}

online() { ping -c1 -W3 archlinux.org >/dev/null 2>&1; }

# 1. pacman refuses packages ("invalid or corrupted package (PGP signature)")
#    when the keyring is old or broken
repair_keyring() {
    if [[ -f "$MOUNT_POINT/var/lib/pacman/db.lck" ]]; then
        rm -f "$MOUNT_POINT/var/lib/pacman/db.lck"
        print_success "Removed a stale pacman lock (an update that was interrupted)"
    fi
    print_status "Setting up pacman's keys again..."
    if ! arch-chroot "$MOUNT_POINT" sh -c 'pacman-key --init && pacman-key --populate archlinux' >/dev/null; then
        print_error "pacman-key failed; read the messages above"
        return 1
    fi
    print_success "Keys set up from the installed keyring"
    if online; then
        print_status "Installing the newest archlinux-keyring..."
        if arch-chroot "$MOUNT_POINT" pacman -Sy --noconfirm archlinux-keyring; then
            arch-chroot "$MOUNT_POINT" pacman-key --populate archlinux >/dev/null
            print_success "Keyring up to date"
        else
            print_error "Could not install archlinux-keyring; read the messages above"
            return 1
        fi
    else
        print_warning "No internet connection: the keyring was refreshed from what is installed, not updated"
    fi
}

# 2. a kernel or initramfs that no longer boots
repair_kernel() {
    local kernels=() k
    for k in linux linux-lts linux-zen linux-hardened; do
        arch-chroot "$MOUNT_POINT" pacman -Q "$k" >/dev/null 2>&1 && kernels+=("$k")
    done
    if (( ${#kernels[@]} == 0 )); then
        print_error "No kernel package is installed on this system"
        return 1
    fi
    print_status "Reinstalling ${kernels[*]}..."
    if online; then
        arch-chroot "$MOUNT_POINT" pacman -Sy --noconfirm "${kernels[@]}" || { print_error "Reinstalling failed; read the messages above"; return 1; }
    else
        # offline: the kernels this ISO carries in its offline repository
        local stage="$MOUNT_POINT/var/cache/aequalyn-repair" files=() f
        mkdir -p "$stage"
        for k in "${kernels[@]}"; do
            f=$(compgen -G "/var/cache/offline-repo/$k-[0-9]*.pkg.tar.zst" | sort -V | tail -n1 || true)
            [[ -n "$f" ]] && cp -f "$f" "$stage/" && files+=("/var/cache/aequalyn-repair/$(basename "$f")")
        done
        if (( ${#files[@]} == 0 )); then
            rm -rf "$stage"
            print_error "No internet connection, and this ISO carries none of these kernels; connect first"
            return 1
        fi
        print_warning "No internet connection: installing the kernel from this ISO"
        arch-chroot "$MOUNT_POINT" pacman -U --noconfirm "${files[@]}" || { rm -rf "$stage"; print_error "Reinstalling failed; read the messages above"; return 1; }
        rm -rf "$stage"
    fi
    print_status "Rebuilding the boot files (mkinitcpio -P)..."
    arch-chroot "$MOUNT_POINT" mkinitcpio -P && print_success "Kernel reinstalled and boot files rebuilt" \
        || { print_error "mkinitcpio failed; read the messages above"; return 1; }
}

# 3. Limine: its files on the EFI partition (or the disk, on BIOS), the firmware's
#    boot entry, and the menu's kernel entries (written by its mkinitcpio hook)
repair_bootloader() {
    if [[ -d /sys/firmware/efi ]]; then
        print_status "Reinstalling Limine on the EFI partition..."
        arch-chroot "$MOUNT_POINT" sh -c 'mkdir -p /boot/EFI/limine /boot/EFI/BOOT \
            && cp /usr/share/limine/BOOTX64.EFI /boot/EFI/limine/ \
            && cp /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI' \
            || { print_error "Could not copy Limine to /boot/EFI"; return 1; }
        print_success "Limine reinstalled"
        # the firmware's boot entry, added again only when it is gone
        if efibootmgr 2>/dev/null | grep -q "Aequalyn (Limine)"; then
            print_success "The firmware's Aequalyn boot entry is there"
        else
            local esp disk part
            esp=$(findmnt -no SOURCE "$MOUNT_POINT/boot" 2>/dev/null || true)
            disk=$(lsblk -no PKNAME "$esp" 2>/dev/null | head -n1)
            part=$(lsblk -no PARTN "$esp" 2>/dev/null | head -n1)
            if [[ -n "$disk" && -n "$part" ]] && efibootmgr --create --disk "/dev/$disk" --part "$part" \
                --label "Aequalyn (Limine)" --loader '\EFI\limine\BOOTX64.EFI' --unicode >/dev/null; then
                print_success "Added the firmware's Aequalyn boot entry"
            else
                print_warning "Could not add a firmware boot entry; the fallback EFI/BOOT/BOOTX64.EFI still boots"
            fi
        fi
    else
        print_status "Reinstalling Limine for BIOS on $SELECTED_DISK..."
        arch-chroot "$MOUNT_POINT" sh -c "cp /usr/share/limine/limine-bios.sys /boot/ && limine bios-install $SELECTED_DISK" \
            || { print_error "limine bios-install failed"; return 1; }
        print_success "Limine reinstalled"
    fi
    print_status "Writing the boot menu's entries again (mkinitcpio -P)..."
    arch-chroot "$MOUNT_POINT" mkinitcpio -P >/dev/null && print_success "Boot menu entries written" \
        || { print_error "mkinitcpio failed; run the kernel repair"; return 1; }
}

run_mode() {
    mount_from_fstab
    local rc=0
    case "$MODE" in
        keyring)    repair_keyring || rc=$? ;;
        kernel)     repair_kernel || rc=$? ;;
        bootloader) repair_bootloader || rc=$? ;;
        manual)     enter_chroot ;;
    esac
    if [[ "$MODE" != manual ]]; then
        echo
        if (( rc == 0 )); then print_success "Repair finished. Reboot to try your system."
        else print_warning "Repair finished with problems; read the messages above."; fi
        read -rp "Press Enter to unmount everything and close..." _
    fi
}

cleanup_and_exit() {
    print_status "Cleaning up..."

    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        umount -R "$MOUNT_POINT" 2>/dev/null || true
        print_success "Unmounted filesystems"
    fi

    if [[ -e "/dev/mapper/$CRYPT_NAME" ]]; then
        cryptsetup close "$CRYPT_NAME" 2>/dev/null || true
        print_success "Closed encrypted device"
    fi

    print_success "Cleanup completed"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode) MODE=${2:-}; shift 2 ;;
            --mode=*) MODE=${1#--mode=}; shift ;;
            -h|--help) sed -n '3,10p' "$0"; exit 0 ;;
            *) print_error "Unknown option: $1"; exit 1 ;;
        esac
    done
    case "$MODE" in
        ""|keyring|kernel|bootloader|manual) ;;
        *) print_error "Unknown mode: $MODE (keyring, kernel, bootloader or manual)"; exit 1 ;;
    esac

    if [[ $EUID -ne 0 ]]; then
        print_error "This script must be run as root."
        exit 1
    fi

    check_dependencies
    trap cleanup_and_exit EXIT

    [[ ! -d "$MOUNT_POINT" ]] && mkdir -p "$MOUNT_POINT"

    select_disk
    detect_encryption

    if [[ "$ENCRYPTED_DISK" == "true" ]]; then
        unlock_encrypted_drive
        ROOT_DEVICE="/dev/mapper/$CRYPT_NAME"
    else
        ROOT_DEVICE="$SELECTED_PARTITION"
    fi

    detect_filesystem "$ROOT_DEVICE"
    mount_filesystem "$ROOT_DEVICE"
    mount_boot_partitions
    mount_virtual_filesystems

    if [[ -n "$MODE" ]]; then run_mode; else ask_chroot; fi
}

# Run main function
main "$@"